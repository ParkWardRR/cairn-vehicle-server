[Unit]
# Cairn v2 ingest server.
#
# Replaces the `systemd-run --user` transient unit used during bring-up, which
# did not survive a reboot. This one does, and it runs as a dedicated system
# user rather than as a login account, because the directory it owns holds the
# receipt-signing seed: that key is what authorizes a device to delete a trip
# from its card, and losing it means reflashing firmware to re-pin a new one.
Description=Cairn v3 ingest and app API server
Documentation=https://github.com/ParkWardRR/cairn-driving-log-selfhosted
Documentation=file:/usr/share/doc/cairn/deploying.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cairn
Group=cairn

# Flags live in the environment file so switching transport does not mean
# editing a unit. CAIRN_ARGS is deliberately unquoted: systemd word-splits a
# bare $VAR, which is what lets one variable carry the whole flag list.
EnvironmentFile=/etc/cairn/server.env

# The keystore master key unwraps every escrowed device storage root, so it must
# not live in the data directory that gets backed up: a backup of that directory
# would then carry the key to everything in it. It is kept in /etc/cairn (root-
# owned, outside StateDirectory) and handed to the service as a credential, which
# systemd exposes at %d for the life of the unit only. Create it once with:
#   openssl rand -hex 32 | sudo install -m 0400 -o root -g root /dev/stdin /etc/cairn/keystore.master
LoadCredential=keystore-master:/etc/cairn/keystore.master

# GNSS assistance (u-blox AssistNow Predictive Orbits for the dongle's receiver).
# The Thingstream ZTP credential is installed by hand as
# /etc/cairn/assistnow-ztp.json, 0640 root:cairn, {"endpoint": ..., "token": ...}.
# Named here rather than in server.env because it is a fixed path and harmless
# when absent: no file means the feature is off and its routes do not exist.
# The server registers the receiver the dongle reports, keeps the chipcode in
# /var/lib/cairn/gnss-assist (0600), and downloads seven days of predictions
# once a day. Check it with:
#   sudo -u cairn /usr/local/bin/cairn-server -data /var/lib/cairn -assistnow-ztp /etc/cairn/assistnow-ztp.json -gnss-assist-status
ExecStart=/usr/local/bin/cairn-server -keystore-master %d/keystore-master -assistnow-ztp /etc/cairn/assistnow-ztp.json $CAIRN_ARGS

# The one outbound call this service makes is to u-blox, so name resolution has
# to work inside the sandbox below. RestrictAddressFamilies leaves no AF_UNIX,
# which glibc's NSS modules (nss-resolve and friends) need; the binary links
# DuckDB, so cgo is on and Go would otherwise hand lookups to glibc. Go's own
# resolver reads /etc/resolv.conf and asks over UDP/TCP, which the sandbox
# allows.
Environment=GODEBUG=netdns=go

Restart=on-failure
RestartSec=5s

# Creates and owns /var/lib/cairn at 0700. The CAS, ledger, issued receipts and
# the signing seed all live here.
StateDirectory=cairn
StateDirectoryMode=0700

# An ingest service parses attacker-supplied bytes for a living — a bundle
# arrives over the network and is scanned frame by frame — so the blast radius
# of a parser bug is worth constraining even on a home LAN.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# Inbound TCP only; no raw sockets, no unix-domain surprises.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes everything read-only except StateDirectory, so the
# certificate directory has to be granted explicitly — read-only, since the
# service has no business rewriting its own key material.
ReadOnlyPaths=/etc/cairn

[Install]
WantedBy=multi-user.target
